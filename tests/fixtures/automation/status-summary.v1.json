{
  "format": "mailswiftsync-status-summary",
  "format_version": 1,
  "description": "Golden v1 contract for `mailswiftsync status --summary`. Paths use [] for array elements and {} for map values; '|' separates allowed types. Add new fields here (additive, same version); never remove, rename, or retype a field without a new format_version.",
  "fields": {
    "active_processes": "array",
    "active_processes[]": "object",
    "active_processes[].executable": "string",
    "active_processes[].job_id": "string",
    "active_processes[].pid": "integer",
    "active_processes[].process_group": "integer|null",
    "active_processes[].run_id": "string",
    "active_processes[].session_id": "integer|null",
    "active_processes[].start_ticks": "integer|null",
    "active_processes_truncated": "boolean",
    "aggregate_mailbox_state_counts": "object",
    "aggregate_mailbox_state_counts.needs_review": "integer",
    "aggregate_mailbox_state_counts.ready": "integer",
    "aggregate_mailbox_state_counts.running": "integer",
    "aggregate_mailbox_state_counts.total": "integer",
    "aggregate_mailbox_state_counts.verified": "integer",
    "format": "string",
    "format_version": "integer",
    "projects": "array",
    "projects[]": "object",
    "projects[].attention_reason_counts": "map",
    "projects[].attention_reason_counts{}": "integer",
    "projects[].batch": "boolean",
    "projects[].destination_endpoint": "string",
    "projects[].id": "string",
    "projects[].mailbox_state_counts": "object",
    "projects[].mailbox_state_counts.needs_review": "integer",
    "projects[].mailbox_state_counts.ready": "integer",
    "projects[].mailbox_state_counts.running": "integer",
    "projects[].mailbox_state_counts.total": "integer",
    "projects[].mailbox_state_counts.verified": "integer",
    "projects[].name": "string",
    "projects[].phase": "string",
    "projects[].source_endpoint": "string",
    "projects_truncated": "boolean",
    "returned_projects": "integer",
    "schema_version": "integer",
    "total_projects": "integer"
  }
}
