{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Provider Compatibility Evidence",
  "description": "Structured evidence for provider compatibility testing",
  "type": "object",
  "required": [
    "provider",
    "source_provider",
    "destination_provider",
    "tested_at",
    "testing_phase",
    "source_version",
    "destination_version",
    "engine",
    "engine_version",
    "test_summary",
    "results"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9_]+->[a-z0-9_]+$",
      "description": "Directed provider-pair compatibility identifier"
    },
    "source_provider": {
      "type": "string",
      "enum": ["gmail", "microsoft365", "fastmail", "generic_imap"]
    },
    "destination_provider": {
      "type": "string",
      "enum": ["gmail", "microsoft365", "fastmail", "generic_imap"]
    },
    "tested_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of test execution"
    },
    "testing_phase": {
      "type": "string",
      "enum": ["dry_pilot", "live_pilot", "recovery_test", "edge_case"],
      "description": "Type of testing performed"
    },
    "source_version": {
      "type": "string",
      "description": "Provider source account version/build"
    },
    "destination_version": {
      "type": "string",
      "description": "Provider destination account version/build"
    },
    "engine": {
      "type": "string",
      "enum": ["imapsync", "doveadm"],
      "description": "Migration engine used"
    },
    "engine_version": {
      "type": "string",
      "description": "Engine version used (e.g., 2.314)"
    },
    "test_summary": {
      "type": "object",
      "required": ["mailboxes_tested", "messages_total", "bytes_total"],
      "properties": {
        "mailboxes_tested": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of mailboxes in test"
        },
        "messages_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total messages migrated"
        },
        "bytes_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total bytes migrated"
        },
        "special_folders_tested": {
          "type": "boolean",
          "description": "Whether special-use folders were included"
        },
        "unicode_folders_tested": {
          "type": "boolean",
          "description": "Whether non-ASCII folder names were tested"
        },
        "large_messages_tested": {
          "type": "boolean",
          "description": "Whether messages > 10MB were included"
        }
      }
    },
    "results": {
      "type": "object",
      "required": ["overall_result", "messages_verified", "verification_confidence"],
      "properties": {
        "overall_result": {
          "type": "string",
          "enum": ["pass", "pass_with_exceptions", "fail"],
          "description": "Final test result"
        },
        "messages_verified": {
          "type": "integer",
          "description": "Messages verified via MailSwiftSync verification"
        },
        "verification_confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"],
          "description": "Confidence level of verification (based on match types)"
        },
        "mismatches": {
          "type": "object",
          "description": "Types of mismatches found",
          "properties": {
            "exact_match": {"type": "integer"},
            "content_match": {"type": "integer"},
            "missing": {"type": "integer"},
            "extra": {"type": "integer"},
            "changed": {"type": "integer"}
          }
        },
        "exceptions_accepted": {
          "type": "integer",
          "description": "Number of exceptions accepted by operator"
        },
        "known_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "issue": {"type": "string"},
              "severity": {"enum": ["info", "warning", "critical"]},
              "workaround": {"type": "string"}
            }
          }
        }
      }
    },
    "tester": {
      "type": "object",
      "required": ["name", "email", "organization"],
      "properties": {
        "name": {"type": "string"},
        "email": {"type": "string", "format": "email"},
        "organization": {"type": "string"}
      },
      "description": "Who performed the testing"
    },
    "notes": {
      "type": "string",
      "description": "Additional context or observations"
    },
    "source_provider": {
      "type": "string",
      "description": "Source email provider (e.g., gmail, microsoft365)"
    },
    "destination_provider": {
      "type": "string",
      "description": "Destination email provider"
    },
    "source_auth_method": {
      "type": "string",
      "enum": ["password", "oauth2"],
      "description": "Authentication method used for source"
    },
    "destination_auth_method": {
      "type": "string",
      "enum": ["password", "oauth2"],
      "description": "Authentication method used for destination"
    },
    "mailswiftsync_commit": {
      "type": "string",
      "description": "Git commit hash of MailSwiftSync version used"
    },
    "run_id": {
      "type": "string",
      "description": "Unique identifier for the migration run"
    },
    "proof_digest": {
      "type": "string",
      "description": "SHA256 digest of the customer-proof JSON that generated this evidence"
    },
    "fixture_id": {
      "type": "string",
      "description": "Identifier for the test fixture/dataset used"
    },
    "test_dataset_digest": {
      "type": "string",
      "description": "Digest of the test dataset/mailboxes used"
    }
  }
}
