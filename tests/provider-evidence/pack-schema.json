{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MailSwiftSync Provider Qualification Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "provider_pair",
    "status",
    "release_gate_required",
    "qualification_bundle_id",
    "tested",
    "qualification_window",
    "phases",
    "known_limitations",
    "evidence_digest",
    "generated_at"
  ],
  "properties": {
    "format": {"const": "mailswiftsync-provider-qualification-pack"},
    "schema_version": {"const": 2},
    "provider_pair": {"type": "string", "pattern": "^[a-z0-9_]+->[a-z0-9_]+$"},
    "status": {"const": "qualification_candidate"},
    "release_gate_required": {"const": true},
    "qualification_bundle_id": {"type": "string", "minLength": 1},
    "tested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_provider",
        "destination_provider",
        "source_version",
        "destination_version",
        "fixture_id",
        "source_auth_method",
        "destination_auth_method",
        "engine",
        "engine_version",
        "mailswiftsync_version",
        "mailswiftsync_commit",
        "mailswiftsync_binary_sha256",
        "imapsync_binary_sha256"
      ],
      "properties": {
        "source_provider": {"type": "string"},
        "destination_provider": {"type": "string"},
        "source_version": {"type": "string", "minLength": 1},
        "destination_version": {"type": "string", "minLength": 1},
        "fixture_id": {"type": "string", "minLength": 1},
        "source_auth_method": {"type": "string"},
        "destination_auth_method": {"type": "string"},
        "engine": {"type": "string"},
        "engine_version": {"type": "string"},
        "mailswiftsync_version": {"type": "string"},
        "mailswiftsync_commit": {"type": "string"},
        "mailswiftsync_binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "imapsync_binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "qualification_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at"],
      "properties": {"started_at": {"type": "string"}, "finished_at": {"type": "string"}}
    },
    "phases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "evidence_file",
          "tested_at",
          "run_id",
          "proof_digest",
          "test_dataset_digest",
          "fixture_id",
          "source_version",
          "destination_version",
          "scenario_ids",
          "direct_imapsync_comparisons",
          "test_summary",
          "results"
        ],
        "properties": {
          "phase": {"enum": ["dry_pilot", "live_pilot", "recovery_test"]},
          "evidence_file": {"type": "string", "pattern": "^[^/\\\\]+$"},
          "tested_at": {"type": "string"},
          "run_id": {"type": "string"},
          "proof_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "test_dataset_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "fixture_id": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "minLength": 1},
          "destination_version": {"type": "string", "minLength": 1},
          "scenario_ids": {"type": "array", "items": {"type": "string"}},
          "direct_imapsync_comparisons": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scenario_id", "comparison"],
              "properties": {
                "scenario_id": {"enum": ["large-mailbox-1gb", "large-mailbox-10gb", "large-mailbox-20gb", "large-mailbox-50gb", "large-mailbox-100gb"]},
                "comparison": {"$ref": "#/$defs/direct_imapsync_comparison"}
              }
            }
          },
          "test_summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mailboxes_tested",
              "messages_total",
              "bytes_total",
              "destination_messages_total",
              "destination_bytes_total",
              "folders_total",
              "destination_folders_total"
            ],
            "properties": {
              "mailboxes_tested": {"type": "integer", "minimum": 0},
              "messages_total": {"type": "integer", "minimum": 0},
              "bytes_total": {"type": "integer", "minimum": 0},
              "destination_messages_total": {"type": "integer", "minimum": 0},
              "destination_bytes_total": {"type": "integer", "minimum": 0},
              "folders_total": {"type": "integer", "minimum": 0},
              "destination_folders_total": {"type": "integer", "minimum": 0},
              "maximum_message_bytes": {"type": "integer", "minimum": 0},
              "large_messages_tested": {"type": "integer", "minimum": 0},
              "unicode_folders_observed": {"type": "boolean"},
              "unicode_folders_tested": {"type": "integer", "minimum": 0},
              "special_use_folders_observed": {"type": "boolean"},
              "special_folders_tested": {"type": "integer", "minimum": 0},
              "mismatch_planted": {"type": "boolean"},
              "mismatch_detected": {"type": "boolean"}
            }
          },
          "results": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "overall_result",
              "messages_covered_by_aggregate_evidence",
              "verification_confidence"
            ],
            "properties": {
              "overall_result": {"const": "pass"},
              "messages_covered_by_aggregate_evidence": {"type": "integer", "minimum": 0},
              "messages_verified": {"type": "integer", "minimum": 0},
              "verification_confidence": {"enum": ["high", "not_applicable"]},
              "exceptions_accepted": {"type": "integer", "const": 0},
              "mismatches": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "exact_match": {"type": "integer", "minimum": 0},
                  "content_match": {"type": "integer", "minimum": 0},
                  "missing": {"type": "integer", "const": 0},
                  "extra": {"type": "integer", "const": 0},
                  "changed": {"type": "integer", "const": 0}
                }
              }
            }
          }
        }
      }
    },
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at": {"type": "string"}
  },
  "$defs": {
    "direct_imapsync_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_run_id", "dataset_digest", "engine_binary_sha256", "engine_settings_sha256", "source_snapshot_file", "source_snapshot_sha256", "destination_baseline_file", "destination_baseline_sha256", "baseline_artifact_file", "baseline_artifact_sha256", "managed_artifact_file", "managed_artifact_sha256", "baseline_metrics", "managed_metrics"],
      "properties": {
        "baseline_run_id": {"type": "string", "minLength": 1},
        "dataset_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "engine_binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "engine_settings_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_snapshot_file": {"type": "string", "pattern": "^[^/\\\\]+$"},
        "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "destination_baseline_file": {"type": "string", "pattern": "^[^/\\\\]+$"},
        "destination_baseline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "baseline_artifact_file": {"type": "string", "pattern": "^[^/\\\\]+$"},
        "baseline_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "managed_artifact_file": {"type": "string", "pattern": "^[^/\\\\]+$"},
        "managed_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "baseline_metrics": {"$ref": "#/$defs/ab_metrics"},
        "managed_metrics": {"$ref": "#/$defs/ab_metrics"}
      }
    },
    "ab_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "messages", "bytes", "peak_rss_bytes", "cpu_seconds", "disk_growth_bytes", "retries", "throttled_seconds"],
      "properties": {
        "wall_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 18446744073709551615},
        "messages": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "peak_rss_bytes": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "cpu_seconds": {"type": "number", "minimum": 0, "maximum": 18446744073709551615},
        "disk_growth_bytes": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "retries": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "throttled_seconds": {"type": "number", "minimum": 0, "maximum": 18446744073709551615}
      }
    }
  }
}
